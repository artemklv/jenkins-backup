# Environment for the local test stand (loaded automatically by docker compose).
# Test-only credentials: do not reuse them outside the test stand.

# Jenkins users (see jenkins-infra/jenkins-casc.yaml)
JENKINS_ADMIN_PASSWORD=admin123
JENKINS_OPERATOR_PASSWORD=operator123
JENKINS_URL=http://localhost:8080/

# Repository with .jenkins/Jenkinsfile.backup (used by the 'myapp-backup' job)
BACKUP_REPO_URL=https://github.com/your-org/jenkins-backup.git
BACKUP_REPO_BRANCH=main

# MongoDB root user
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=mongo123
